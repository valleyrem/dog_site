msgstr "Общая информация."

#: woof/templates/woof/dogs_list.html:125 woof/templates/woof/post.html:630
msgid "Show less"
msgstr "Показать меньше"

#: woof/templates/woof/dogs_list.html:126 woof/templates/woof/post.html:631
msgid "Show more"
msgstr "Показать ещё"

